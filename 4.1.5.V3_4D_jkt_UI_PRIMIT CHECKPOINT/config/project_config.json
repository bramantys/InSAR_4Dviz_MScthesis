{
  "schema_version": "0.3",
  "user_inputs": {
    "source_file": "data/jakarta_enu_estimates.csv",
    "source_crs": "EPSG:23830",
    "rum_size_m": 450.0,
    "expected_rum_count": 4779,
    "synthetic_epochs": {
      "vertical_measurement_behavior": "sinusoidal",
      "vertical_measurement_noise": "medium",
      "vertical_model": "linear",
      "uncertainty_quality": "high",
      "start_date": "2014-01-01",
      "end_date": "2025-01-01",
      "interval_days": 14
    }
  },
  "source_schema": {
    "coordinate_fields": {
      "x": "x_rum",
      "y": "y_rum"
    },
    "velocity_fields": {
      "east": "east",
      "north": "north",
      "up": "up"
    },
    "uncertainty_fields": {
      "var_east": "var_east",
      "var_north": "var_north",
      "var_up": "var_up",
      "covar_en": "covar_en",
      "covar_eu": "covar_eu",
      "covar_nu": "covar_nu"
    }
  },
  "synthetic_epoch_models": {
    "linear": {
      "velocity_component": "up",
      "start_displacement_at_zero": true,
      "output_unit": "mm"
    },
    "sinusoidal": {
      "preset": "seasonal_default",
      "base_trend": "from_velocity",
      "velocity_component": "up",
      "amplitude_mm": 5.0,
      "period_days": 365.25,
      "phase_days": 45.0,
      "apply_to": "all_rums",
      "start_displacement_at_zero": true,
      "output_unit": "mm"
    }
  },
  "uncertainty_quality_presets": {
    "high": {
      "base_sigma_mm": 2.0,
      "temporal_growth_mm_per_year": 0.2,
      "seasonal_sigma_mm": 0.5,
      "spike_probability": 0.005,
      "spike_sigma_mm": 5.0
    },
    "medium": {
      "base_sigma_mm": 5.0,
      "temporal_growth_mm_per_year": 0.5,
      "seasonal_sigma_mm": 1.5,
      "spike_probability": 0.01,
      "spike_sigma_mm": 10.0
    },
    "low": {
      "base_sigma_mm": 10.0,
      "temporal_growth_mm_per_year": 1.0,
      "seasonal_sigma_mm": 3.0,
      "spike_probability": 0.03,
      "spike_sigma_mm": 20.0
    }
  },
  "paths": {
    "internal_dir": "_internal",
    "pipeline_dir": "_internal/pipeline",
    "pipeline_output_dir": "_internal/data_pipeline",
    "cesium_dir": "_internal/cesium",
    "run_records_dir": "run_records"
  },
  "pipeline_behavior": {
    "clean_pipeline_output_before_run": true,
    "overwrite_existing_outputs": true,
    "stop_on_first_error": true,
    "rum_count_mismatch_action": "warn",
    "rum_size_mismatch_action": "warn",
    "write_human_log": true,
    "write_manifest_json": true,
    "copy_latest_run_records": true
  },
  "viewer": {
    "dev_viewer": "viz1_dev.html",
    "audience_viewer": "viz1_viewer.html",
    "camera_mode": "auto_from_dataset_bbox",
    "bbox_mode": "auto_from_rum_footprints",
    "display_datum_height_m": 1000.0,
    "wall_base_height_m": 999.0,
    "vertical_exaggeration_m_per_mm": 5.0,
    "height_texture": {
      "v_min_mm": -1500.0,
      "v_max_mm": 1500.0,
      "packing": "uint16_rg8_plus_sigma_b8"
    }
  },
  "horizontal_dev_layers": {
    "enabled": true,
    "minimum_speed_mm_yr": 0.2,
    "visibility_sigma_multiplier": 1.0,
    "visibility_label": "1σ",
    "ellipse_sigma_multiplier": 2.0,
    "ellipse_label": "2σ",
    "arrow_scale_m_per_mm_yr": 22.5,
    "auto_scale": true,
    "arrow_reference_percentile": 99.5,
    "ellipse_reference_percentile": 99.5,
    "arrow_max_length_rum_fraction": 0.8,
    "ellipse_max_diameter_rum_fraction": 0.75,
    "arrow_anchor_fraction_at_rum_center": 0.75,
    "ellipse_scale_mode": "same_as_arrow",
    "ellipse_visual_scale_factor": 1.0,
    "arrow_significance_filter": true,
    "ellipse_match_arrow_filter": true
  },
  "synthetic_epoch_presets": {
    "vertical_measurement_noise_mm": {
      "low": 2.0,
      "medium": 5.0,
      "high": 8.0
    },
    "vertical_measurement_behavior": {
      "linear": {
        "description": "measurement = linear trend + noise",
        "base_trend": "from_velocity",
        "velocity_component": "up",
        "start_displacement_at_zero": true,
        "output_unit": "mm"
      },
      "sinusoidal": {
        "description": "measurement = linear trend + seasonal wiggle + noise",
        "base_trend": "from_velocity",
        "velocity_component": "up",
        "amplitude_mm": 5.0,
        "period_days": 365.25,
        "phase_days": 45.0,
        "apply_to": "all_rums",
        "start_displacement_at_zero": true,
        "output_unit": "mm"
      }
    },
    "vertical_model": {
      "linear": {
        "description": "model = linear trend from velocity; intended for RUM height / choropleth",
        "base_trend": "from_velocity",
        "velocity_component": "up",
        "start_displacement_at_zero": true,
        "output_unit": "mm"
      },
      "sinusoidal": {
        "description": "model = linear trend + seasonal model; intended for future seasonal parcel/model tests",
        "base_trend": "from_velocity",
        "velocity_component": "up",
        "amplitude_mm": 5.0,
        "period_days": 365.25,
        "phase_days": 45.0,
        "apply_to": "all_rums",
        "start_displacement_at_zero": true,
        "output_unit": "mm"
      }
    }
  }
}